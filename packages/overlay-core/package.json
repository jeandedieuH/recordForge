{
  "name": "@recordforge/overlay-core",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "test": "vitest run",
    "build:wasm": "bun scripts/build-wasm.ts",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@recordforge/contracts": "workspace:*"
  },
  "devDependencies": {
    "@recordforge/config": "workspace:*",
    "eslint": "^10.8.0",
    "prettier": "^3.5.6",
    "typescript": "~7.0.2",
    "vitest": "^3.2.7"
  }
}
