      "tags": ["circle", "ellipse", "highlight", "ring"],
      "definition": {
        "type": "circle",
        "defaultWidth": 180,
        "defaultHeight": 180,
        "defaultStrokeWidth": 4,
        "defaultStrokeColor": "#f59e0b",
