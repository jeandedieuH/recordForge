{
  "version": 1,
  "categories": ["frame", "highlight", "pointer", "callout", "spotlight", "badge"],
  "presets": [
    {
      "id": "rectangle",
      "name": "Rectangle Box",
      "description": "Outlined box to focus and highlight areas",
      "category": "frame",
      "tags": ["rectangle", "frame", "highlight"],
      "definition": {
        "type": "rectangle",
        "defaultWidth": 260,
        "defaultHeight": 160,
        "defaultStrokeWidth": 4,
        "defaultStrokeColor": "#38bdf8",
        "defaultFillColor": "#38bdf8",
        "defaultFillOpacity": 0.1,
        "defaultCornerRadius": 0,
        "defaultArrowStartHead": "none",
        "defaultArrowEndHead": "none",
        "defaultStrokeStyle": "solid"
      }
    },
    {
      "id": "rounded-rect",
      "name": "Rounded Card",
      "description": "Smooth rounded frame for modern UI callouts",
      "category": "frame",
      "tags": ["rounded", "card", "frame"],
      "definition": {
        "type": "rounded-rect",
        "defaultWidth": 280,
        "defaultHeight": 160,
        "defaultStrokeWidth": 4,
        "defaultStrokeColor": "#38bdf8",
        "defaultFillColor": "#38bdf8",
        "defaultFillOpacity": 0.12,
        "defaultCornerRadius": 14,
        "defaultArrowStartHead": "none",
        "defaultArrowEndHead": "none",
        "defaultStrokeStyle": "solid"
      }
    },
    {
      "id": "circle",
      "name": "Circle / Ellipse",
