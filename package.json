{
  "name": "recordforge",
  "private": true,
  "version": "1.2.4",
  "description": "Local-first screen recorder and lightweight editor",
  "license": "GPL-3.0-or-later",
  "author": "Prestige Tech & recordForge Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeandedieuH/recordForge.git"
  },
  "homepage": "https://github.com/jeandedieuH/recordForge",
  "bugs": {
    "url": "https://github.com/jeandedieuH/recordForge/issues"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:wasm": "turbo run build:wasm",
    "build:wasm:overlay": "bun run --cwd packages/overlay-core build:wasm",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint format:check typecheck test",
    "tauri": "turbo run tauri --filter=desktop",
    "check:versions": "node tooling/scripts/check-versions.mjs",
    "prepare:updater": "node tooling/scripts/prepare-updater-config.mjs",
    "setup:ffmpeg": "node tooling/ffmpeg/setup.mjs",
    "fixtures:generate": "bun run tooling/fixtures/generate.ts"
  },
  "devDependencies": {
    "turbo": "^2.10.9",
    "typescript": "^6.0.3",
    "@types/node": "^26.2.0"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22.15.0"
  }
}
