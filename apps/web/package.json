{
  "name": "@recordforge/web",
  "private": true,
  "version": "1.4.6",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "bun run generate-routes && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "bun run generate-routes && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "convex:dev": "convex dev --start 'bun --bun run dev'",
    "convex:once": "convex dev --once",
    "convex:seed": "convex run tasks:seed"
  },
  "dependencies": {
    "@convex-dev/react-query": "^0.1.0",
    "@recordforge/ui": "workspace:*",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-ssr-query": "^1.167.2",
    "@tanstack/react-start": "^1.168.49",
    "convex": "^1.45.0",
    "lucide-react": "1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@recordforge/config": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.12",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
