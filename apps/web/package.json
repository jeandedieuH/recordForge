{
  "name": "@recordforge/web",
  "private": true,
  "version": "2.0.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "bun run generate-routes && tsc --noEmit && vite build",
    "start": "srvx --prod -s ../client dist/server/server.js",
    "preview": "vite preview",
    "typecheck": "bun run generate-routes && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "convex:dev": "convex dev --start 'bun --bun run dev'",
    "convex:once": "convex dev --once"
  },
  "dependencies": {
    "@convex-dev/react-query": "^0.1.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@recordforge/ui": "workspace:*",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.60",
    "convex": "^1.46.0",
    "lucide-react": "1.41.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "srvx": "^0.11.22",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@recordforge/config": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.40",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
