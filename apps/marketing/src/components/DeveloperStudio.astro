---
---

<section id="studio" class="py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-border relative overflow-hidden">
  {/* Ambient Lighting */}
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-140 h-70 bg-primary/10 blur-[140px] pointer-events-none rounded-full"></div>

  <div class="text-center max-w-3xl mx-auto mb-16 relative z-10">
    <span class="px-3.5 py-1 rounded-full bg-surface border border-primary/40 text-xs font-mono text-track-screen uppercase tracking-wider">
      ENGINEERING STUDIO &amp; ARCHITECT
    </span>
    <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-foreground font-['Outfit'] mt-3">
      Crafted with Precision by <span class="text-gradient-primary">Prestige Tech</span>
    </h2>
    <p class="mt-4 text-base sm:text-lg text-muted-foreground leading-relaxed">
      RecordForge is designed and built by an independent engineering studio passionate about native performance, zero-bloat desktop architectures, and uncompromising creator privacy.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto relative z-10">
    {/* Studio Card: Prestige Tech */}
    <div class="rounded-3xl border border-border bg-surface/90 backdrop-blur-xl p-8 sm:p-10 flex flex-col justify-between shadow-2xl hover:border-primary/50 transition-all">
      <div>
        <div class="flex items-center justify-between gap-4 mb-6">
          <div class="flex items-center gap-3.5">
            <div class="w-12 h-12 rounded-2xl bg-primary/15 border border-primary/30 flex items-center justify-center text-primary">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <line x1="2" y1="12" x2="22" y2="12"/>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
              </svg>
            </div>
            <div>
              <h3 class="text-2xl font-bold text-foreground font-['Outfit']">Prestige Tech</h3>
              <p class="text-xs font-mono text-track-screen">Software Engineering Studio</p>
            </div>
          </div>
          <span class="px-2.5 py-1 rounded-full bg-surface-container-high border border-border text-[10px] font-mono text-muted-foreground">
            Studio
          </span>
        </div>

        <p class="text-sm text-muted-foreground leading-relaxed">
          Prestige Tech develops modern, privacy-respecting, high-performance desktop and cloud applications. Dedicated to building native software that respects system resources and empowers digital creators.
        </p>

        <div class="mt-6 pt-6 border-t border-border space-y-3">
          <div class="flex items-center justify-between text-xs text-muted-foreground font-mono">
            <span>Official Website</span>
            <span class="text-foreground font-semibold">prestigetech.dev</span>
          </div>
          <div class="flex items-center justify-between text-xs text-muted-foreground font-mono">
            <span>Specialty</span>
            <span class="text-foreground">Native Systems &amp; Media Pipelines</span>
          </div>
        </div>
      </div>

      <div class="mt-8 pt-6 border-t border-border">
        <a
          href="https://prestigetech.dev"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-primary hover:bg-primary-hover text-foreground font-bold text-xs sm:text-sm tracking-wide shadow-lg shadow-primary/30 transition-all cursor-pointer group"
        >
          <span>Visit prestigetech.dev</span>
          <svg class="w-4 h-4 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 3 21 9"/>
            <line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
        </a>
      </div>
    </div>

    {/* Master Developer Card */}
    <div class="rounded-3xl border border-border bg-surface/90 backdrop-blur-xl p-8 sm:p-10 flex flex-col justify-between shadow-2xl hover:border-secondary/50 transition-all">
      <div>
        <div class="flex items-center justify-between gap-4 mb-6">
          <div class="flex items-center gap-3.5">
            <div class="w-12 h-12 rounded-2xl bg-secondary/15 border border-secondary/30 flex items-center justify-center text-track-annotation">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="16 18 22 12 16 6"/>
                <polyline points="8 6 2 12 8 18"/>
              </svg>
            </div>
            <div>
              <h3 class="text-2xl font-bold text-foreground font-['Outfit']">Master Developer</h3>
              <p class="text-xs font-mono text-track-annotation">Lead Architect &amp; Engineer</p>
            </div>
          </div>
          <span class="px-2.5 py-1 rounded-full bg-surface-container-high border border-border text-[10px] font-mono text-muted-foreground">
            Architect
          </span>
        </div>

        <p class="text-sm text-muted-foreground leading-relaxed">
          Architected and engineered the RecordForge capture pipeline, WASAPI audio synchronizer, subpixel vector cursor engine, and non-linear timeline proxy compositor for seamless desktop recording.
        </p>

        <div class="mt-6 pt-6 border-t border-border space-y-3">
          <div class="flex items-center justify-between text-xs text-muted-foreground font-mono">
            <span>Portfolio / Profile</span>
            <span class="text-foreground font-semibold">me.prestigetech.dev</span>
          </div>
          <div class="flex items-center justify-between text-xs text-muted-foreground font-mono">
            <span>Architecture Focus</span>
            <span class="text-foreground">Rust, Tauri v2, WASM, WASAPI</span>
          </div>
        </div>
      </div>

      <div class="mt-8 pt-6 border-t border-border">
        <a
          href="https://me.prestigetech.dev"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-surface hover:bg-surface-container-high border border-secondary/40 hover:border-secondary text-foreground font-bold text-xs sm:text-sm tracking-wide transition-all cursor-pointer group"
        >
          <span>Visit me.prestigetech.dev</span>
          <svg class="w-4 h-4 text-track-annotation group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 3 21 9"/>
            <line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
