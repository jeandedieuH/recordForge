---
---

<footer class="border-t border-border bg-background py-16 text-muted-foreground text-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-5 gap-10 pb-12 border-b border-border">
      {/* Brand Column */}
      <div class="md:col-span-2 space-y-4">
        <a href="#" class="inline-block group">
          <img
            src="/logo.png"
            alt="RecordForge"
            class="h-20 w-auto object-contain select-none group-hover:opacity-90 transition-opacity"
          />
        </a>
        <p class="text-xs text-muted-foreground max-w-sm leading-relaxed">
          The local-first, high-performance desktop screen recorder and multi-track editor for Windows 11. Built with Rust, Tauri v2, and WebAssembly.
        </p>
        <div class="flex items-center gap-3 pt-2">
          <a
            href="https://github.com/jeandedieuH/recordForge"
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 rounded-lg bg-surface hover:bg-surface-container-high border border-border text-muted-foreground hover:text-foreground transition-colors"
            title="GitHub Repository"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
          </a>
        </div>
      </div>

      {/* Product Links */}
      <div class="space-y-3">
        <h4 class="text-xs font-semibold text-foreground uppercase tracking-wider font-mono">Product</h4>
        <ul class="space-y-2">
          <li><a href="#features" class="hover:text-track-screen transition-colors">Core Features</a></li>
          <li><a href="#cursor-engine" class="hover:text-track-screen transition-colors">Cursor Telemetry</a></li>
          <li><a href="#editor" class="hover:text-track-screen transition-colors">Timeline Editor</a></li>
          <li><a href="#benchmarks" class="hover:text-track-screen transition-colors">Performance</a></li>
          <li><a href="#download" class="hover:text-track-screen transition-colors">Windows Installer</a></li>
        </ul>
      </div>

      {/* Engineering Links */}
      <div class="space-y-3">
        <h4 class="text-xs font-semibold text-foreground uppercase tracking-wider font-mono">Engineering</h4>
        <ul class="space-y-2">
          <li><a href="#architecture" class="hover:text-track-screen transition-colors">System Architecture</a></li>
          <li><a href="https://github.com/jeandedieuH/recordForge" target="_blank" class="hover:text-track-screen transition-colors">Source Code</a></li>
          <li><a href="https://github.com/jeandedieuH/recordForge/releases" target="_blank" class="hover:text-track-screen transition-colors">Releases &amp; Changelog</a></li>
          <li><a href="#faq" class="hover:text-track-screen transition-colors">FAQ &amp; Diagnostics</a></li>
        </ul>
      </div>

      {/* Trust & Legal */}
      <div class="space-y-3">
        <h4 class="text-xs font-semibold text-foreground uppercase tracking-wider font-mono">Open Source</h4>
        <ul class="space-y-2">
          <li><span class="text-foreground">MIT Open-Source License</span></li>
          <li><span class="text-foreground">100% Offline &amp; Privacy First</span></li>
          <li><span class="text-foreground">Zero Third-Party Telemetry</span></li>
          <li><span class="text-foreground">Encrypted OS Vault Storage</span></li>
        </ul>
      </div>
    </div>

    {/* Bottom Copyright */}
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-subtle-foreground">
      <div>
        &copy; {new Date().getFullYear()} RecordForge &bull; Released under the MIT License.
      </div>
      <div class="flex items-center gap-1">
        Crafted with precision for creators, engineers, and educators.
      </div>
    </div>
  </div>
</footer>
