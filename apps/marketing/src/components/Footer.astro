---
---

<footer class="border-t border-border bg-background py-16 text-muted-foreground text-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-5 gap-10 pb-12 border-b border-border">
      {/* Brand Column */}
      <div class="md:col-span-2 space-y-4">
        <a href="#" class="inline-block group">
          <img
            src="/logo.png"
            alt="RecordForge"
            class="h-20 w-auto object-contain select-none group-hover:opacity-90 transition-opacity"
          />
        </a>
        <p class="text-xs text-muted-foreground max-w-sm leading-relaxed">
          The local-first, high-performance desktop screen recorder and multi-track editor for Windows 11. Engineered by Prestige Tech with Rust, Tauri v2, WASAPI, and WebAssembly.
        </p>
        <div class="flex items-center gap-3 pt-2">
          <a
            href="https://prestigetech.dev"
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-1.5 rounded-lg bg-surface hover:bg-surface-container-high border border-border text-foreground hover:text-track-screen text-xs font-medium transition-colors"
          >
            prestigetech.dev
          </a>
          <a
            href="https://me.prestigetech.dev"
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-1.5 rounded-lg bg-surface hover:bg-surface-container-high border border-border text-foreground hover:text-track-annotation text-xs font-medium transition-colors"
          >
            me.prestigetech.dev
          </a>
        </div>
      </div>

      {/* Product Links */}
      <div class="space-y-3">
        <h4 class="text-xs font-semibold text-foreground uppercase tracking-wider font-mono">Product</h4>
        <ul class="space-y-2">
          <li><a href="#features" class="hover:text-track-screen transition-colors">Core Features</a></li>
          <li><a href="#cursor-engine" class="hover:text-track-screen transition-colors">Cursor Telemetry</a></li>
          <li><a href="#editor" class="hover:text-track-screen transition-colors">Timeline Editor</a></li>
          <li><a href="#pricing" class="hover:text-track-screen transition-colors">Pricing &amp; Roadmap</a></li>
          <li><a href="#download" class="hover:text-track-screen transition-colors">Windows Installer</a></li>
        </ul>
      </div>

      {/* Engineering & Studio */}
      <div class="space-y-3">
        <h4 class="text-xs font-semibold text-foreground uppercase tracking-wider font-mono">Engineering</h4>
        <ul class="space-y-2">
          <li><a href="#architecture" class="hover:text-track-screen transition-colors">System Architecture</a></li>
          <li><a href="#benchmarks" class="hover:text-track-screen transition-colors">Performance Benchmarks</a></li>
          <li><a href="https://prestigetech.dev" target="_blank" class="hover:text-track-screen transition-colors">Prestige Tech Studio</a></li>
          <li><a href="https://me.prestigetech.dev" target="_blank" class="hover:text-track-screen transition-colors">Master Developer Profile</a></li>
          <li><a href="#faq" class="hover:text-track-screen transition-colors">FAQ &amp; Diagnostics</a></li>
        </ul>
      </div>

      {/* Licensing & Trust */}
      <div class="space-y-3">
        <h4 class="text-xs font-semibold text-foreground uppercase tracking-wider font-mono">Licensing &amp; Trust</h4>
        <ul class="space-y-2">
          <li><span class="text-foreground">Free Proprietary Software</span></li>
          <li><span class="text-foreground">Version 2.0 Premium Tier</span></li>
          <li><span class="text-foreground">100% Offline &amp; Privacy First</span></li>
          <li><span class="text-foreground">Zero Third-Party Telemetry</span></li>
          <li><span class="text-foreground">Encrypted OS Vault Storage</span></li>
        </ul>
      </div>
    </div>

    {/* Bottom Copyright */}
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-subtle-foreground">
      <div>
        &copy; {new Date().getFullYear()} Prestige Tech &bull; RecordForge is Free Proprietary Software. All rights reserved.
      </div>
      <div class="flex items-center gap-2">
        <a href="https://prestigetech.dev" target="_blank" rel="noopener noreferrer" class="hover:text-foreground transition-colors">Prestige Tech</a>
        <span>&bull;</span>
        <a href="https://me.prestigetech.dev" target="_blank" rel="noopener noreferrer" class="hover:text-foreground transition-colors">Master Developer</a>
      </div>
    </div>
  </div>
</footer>
