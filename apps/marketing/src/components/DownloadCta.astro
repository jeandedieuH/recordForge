---
---

<section id="download" class="py-24 relative overflow-hidden">
  {/* Glowing Backdrop in brand primary & secondary */}
  <div class="absolute inset-0 bg-linear-to-b from-transparent via-primary/15 to-background pointer-events-none"></div>
  <div class="absolute bottom-12 left-1/2 -translate-x-1/2 w-200 h-75 bg-linear-to-r from-primary/20 via-primary-container/20 to-secondary/20 blur-[140px] pointer-events-none rounded-full"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="max-w-4xl mx-auto rounded-3xl border border-border bg-linear-to-b from-surface via-surface-dim to-background p-8 sm:p-14 text-center shadow-2xl relative overflow-hidden">
      
      {/* Decorative Top Pill with official icon */}
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-surface border border-primary/40 text-xs font-mono text-track-screen mb-6">
        <img src="/forge-mark.svg" alt="RecordForge logo" class="w-3.5 h-3.5 object-contain" />
        <span class="text-xs font-semibold text-track-screen uppercase tracking-wider font-mono">
          Ready to Record?
        </span>
      </div>

      <h2 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-foreground font-['Outfit'] max-w-4xl mx-auto leading-tight">
        High-fidelity screen recording without the system strain.
      </h2>
      <p class="mt-5 text-base sm:text-lg text-muted-foreground max-w-2xl mx-auto leading-relaxed">
        Download RecordForge for Windows today. 100% free desktop edition, local-first, zero telemetry tracking, and engineered by Prestige Tech.
      </p>

      {/* Main Download Button and Options */}
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4 max-w-lg mx-auto">
        <a
          href="#download"
          class="w-full sm:w-auto flex items-center justify-center gap-3 px-8 py-4 rounded-2xl bg-primary hover:bg-primary-hover text-foreground font-bold text-sm sm:text-base tracking-wide shadow-xl shadow-primary/40 hover:shadow-primary/60 hover:scale-[1.02] active:scale-[0.98] transition-all group cursor-pointer"
        >
          <svg class="w-5 h-5 group-hover:-translate-y-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          <div class="text-left">
            <div>Download Free for Windows</div>
            <div class="text-[10px] font-normal text-on-primary-container opacity-90">64-bit .msi Installer (~45MB)</div>
          </div>
        </a>

        <a
          href="https://prestigetech.dev"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto flex items-center justify-center gap-2 px-6 py-4 rounded-2xl bg-surface hover:bg-surface-container-high border border-border text-foreground font-semibold text-sm sm:text-base backdrop-blur-md transition-all hover:border-track-screen/40 cursor-pointer"
        >
          <span class="w-2 h-2 rounded-full bg-primary"></span>
          <span>Prestige Tech Studio</span>
        </a>
      </div>

      {/* System Requirements & Verification Specs */}
      <div class="mt-12 pt-8 border-t border-border grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs font-mono text-muted-foreground">
        <div class="p-3 rounded-xl bg-background border border-border text-left">
          <div class="text-foreground font-semibold flex items-center gap-1.5 mb-1">
            <svg class="w-3.5 h-3.5 text-track-screen" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            Operating System
          </div>
          <div>Windows 11 / Windows 10 64-bit (Build 19041+)</div>
        </div>

        <div class="p-3 rounded-xl bg-background border border-border text-left">
          <div class="text-foreground font-semibold flex items-center gap-1.5 mb-1">
            <svg class="w-3.5 h-3.5 text-track-mic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            Hardware Profile
          </div>
          <div>Minimum 4GB RAM &bull; Intel / AMD / NVENC</div>
        </div>

        <div class="p-3 rounded-xl bg-background border border-border text-left">
          <div class="text-foreground font-semibold flex items-center gap-1.5 mb-1">
            <svg class="w-3.5 h-3.5 text-track-annotation" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            Integrity Checksum
          </div>
          <div>SHA-256 Verified Binary Releases</div>
        </div>
      </div>
    </div>
  </div>
</section>
