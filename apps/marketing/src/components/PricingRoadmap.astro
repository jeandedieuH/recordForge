---
---

<section id="pricing" class="py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative overflow-hidden">
  {/* Atmospheric backdrop lighting */}
  <div class="absolute top-1/2 left-1/4 -translate-y-1/2 w-96 h-96 bg-primary/10 blur-[130px] pointer-events-none rounded-full"></div>
  <div class="absolute top-1/2 right-1/4 -translate-y-1/2 w-96 h-96 bg-secondary/10 blur-[130px] pointer-events-none rounded-full"></div>

  <div class="text-center max-w-3xl mx-auto mb-16 relative z-10">
    <span class="px-3.5 py-1 rounded-full bg-surface border border-primary/40 text-xs font-mono text-track-screen uppercase tracking-wider">
      TRANSPARENT MONETIZATION &amp; ROADMAP
    </span>
    <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-foreground font-['Outfit'] mt-3">
      Free Core Forever. <span class="text-gradient-primary">Optional Premium in V2.</span>
    </h2>
    <p class="mt-4 text-base sm:text-lg text-muted-foreground leading-relaxed">
      RecordForge is free proprietary software. The essential desktop recorder and timeline editor will always remain 100% free with zero watermarks. Version 2 will introduce optional paid premium features for power creators and teams.
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-5xl mx-auto relative z-10">
    {/* Plan 1: Core Edition (Always Free) */}
    <div class="rounded-3xl border border-primary/40 bg-surface/90 backdrop-blur-xl p-8 sm:p-10 flex flex-col justify-between shadow-2xl relative overflow-hidden group hover:border-primary/70 transition-all">
      <div class="absolute top-0 right-0 px-4 py-1.5 rounded-bl-2xl bg-primary/20 border-b border-l border-primary/30 text-track-screen text-[11px] font-mono font-bold uppercase tracking-wider">
        Current &bull; Always Free
      </div>

      <div>
        <div class="flex items-center gap-3 mb-4">
          <div class="p-2.5 rounded-xl bg-primary/15 text-track-screen border border-primary/30">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
          <div>
            <h3 class="text-2xl font-bold text-foreground font-['Outfit']">Free Core Edition</h3>
            <p class="text-xs text-muted-foreground">Proprietary Free Desktop License</p>
          </div>
        </div>

        <div class="my-6 pb-6 border-b border-border">
          <div class="flex items-baseline gap-2">
            <span class="text-4xl sm:text-5xl font-black text-foreground font-['Outfit']">$0</span>
            <span class="text-sm font-medium text-muted-foreground">/ forever</span>
          </div>
          <p class="text-xs text-muted-foreground mt-2">
            Free for personal, commercial, educational, and developer use.
          </p>
        </div>

        <div class="space-y-3.5 text-xs sm:text-sm text-muted-foreground">
          <div class="text-foreground font-semibold text-xs uppercase tracking-wider font-mono">
            Included Core Capabilities:
          </div>

          <div class="flex items-start gap-3">
            <svg class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span class="text-foreground">Unlimited 4K 60FPS Screen, Window &amp; Region Capture</span>
          </div>

          <div class="flex items-start gap-3">
            <svg class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span class="text-foreground">Zero Watermarks &amp; No Duration Restrictions</span>
          </div>

          <div class="flex items-start gap-3">
            <svg class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span class="text-foreground">WASAPI Loopback Zero-Drift Audio Mixing (Mic + System)</span>
          </div>

          <div class="flex items-start gap-3">
            <svg class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span class="text-foreground">Built-in Multi-Track Proxy Timeline Editor (Cut, Split, Trim)</span>
          </div>

          <div class="flex items-start gap-3">
            <svg class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span class="text-foreground">Hardware NVENC, QuickSync &amp; AMF MP4 Exports</span>
          </div>

          <div class="flex items-start gap-3">
            <svg class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span class="text-foreground">60Hz Subpixel Vector Cursor Smoothing &amp; Visual Ripples</span>
          </div>

          <div class="flex items-start gap-3">
            <svg class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span class="text-foreground">100% Offline &amp; SQLite WAL Crash Recovery</span>
          </div>
        </div>
      </div>

      <div class="mt-8 pt-6 border-t border-border">
        <a
          href="#download"
          class="w-full flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-primary hover:bg-primary-hover text-foreground font-bold text-xs sm:text-sm tracking-wide shadow-lg shadow-primary/30 transition-all cursor-pointer"
        >
          <span>Download Free for Windows</span>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>

    {/* Plan 2: Version 2.0 Premium (In Development) */}
    <div class="rounded-3xl border border-secondary/40 bg-surface/90 backdrop-blur-xl p-8 sm:p-10 flex flex-col justify-between shadow-2xl relative overflow-hidden group hover:border-secondary/70 transition-all">
      <div class="absolute top-0 right-0 px-4 py-1.5 rounded-bl-2xl bg-secondary/20 border-b border-l border-secondary/30 text-track-annotation text-[11px] font-mono font-bold uppercase tracking-wider">
        Version 2.0 &bull; Roadmap
      </div>

      <div>
        <div class="flex items-center gap-3 mb-4">
          <div class="p-2.5 rounded-xl bg-secondary/15 text-track-annotation border border-secondary/30">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
            </svg>
          </div>
          <div>
            <h3 class="text-2xl font-bold text-foreground font-['Outfit']">Version 2 Premium</h3>
            <p class="text-xs text-muted-foreground">Optional Creator &amp; Studio Tools</p>
          </div>
        </div>

        <div class="my-6 pb-6 border-b border-border">
          <div class="flex items-baseline gap-2">
            <span class="text-2xl sm:text-3xl font-extrabold text-foreground font-['Outfit']">Coming in V2</span>
            <span class="text-xs font-mono px-2 py-0.5 rounded bg-secondary/20 text-track-annotation border border-secondary/30">Active Development</span>
          </div>
          <p class="text-xs text-muted-foreground mt-2">
            Optional enhancements for high-velocity teams and professional content creators.
          </p>
        </div>

        <div class="space-y-3.5 text-xs sm:text-sm text-muted-foreground">
          <div class="text-foreground font-semibold text-xs uppercase tracking-wider font-mono">
            Upcoming Premium Features:
          </div>

          <div class="flex items-start gap-3">
            <svg class="w-4 h-4 text-track-annotation shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
            <span class="text-foreground">AI-Powered Smart Zoom &amp; Cursor Focus Framing</span>
          </div>

          <div class="flex items-start gap-3">
            <svg class="w-4 h-4 text-track-annotation shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
            <span class="text-foreground">Multi-Track Studio Audio Isolation &amp; Noise Suppression</span>
          </div>

          <div class="flex items-start gap-3">
            <svg class="w-4 h-4 text-track-annotation shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
            <span class="text-foreground">Cloud Workspace Sync &amp; Direct One-Click Share Links</span>
          </div>

          <div class="flex items-start gap-3">
            <svg class="w-4 h-4 text-track-annotation shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
            <span class="text-foreground">Custom Branding Kits, Intro/Outro Overlays &amp; Watermarks</span>
          </div>

          <div class="flex items-start gap-3">
            <svg class="w-4 h-4 text-track-annotation shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
            <span class="text-foreground">Automatic Speech-to-Text Captions &amp; Chapter Markers</span>
          </div>

          <div class="flex items-start gap-3">
            <svg class="w-4 h-4 text-track-annotation shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
            <span class="text-foreground">Direct S3 / Google Drive / Team Library Publishing</span>
          </div>
        </div>
      </div>

      <div class="mt-8 pt-6 border-t border-border">
        <a
          href="https://prestigetech.dev"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-surface hover:bg-surface-container-high border border-secondary/40 hover:border-secondary text-foreground font-bold text-xs sm:text-sm tracking-wide transition-all cursor-pointer"
        >
          <span>Follow Prestige Tech Updates</span>
          <svg class="w-4 h-4 text-track-annotation" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 3 21 9"/>
            <line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
