---
---

<header class="sticky top-0 z-50 w-full border-b border-border bg-background/90 backdrop-blur-xl transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    {/* Brand Logo */}
    <a href="#" class="flex items-center gap-3 group">
      <img
        src="/logo.png"
        alt="RecordForge"
        class="h-12 w-auto object-contain select-none group-hover:opacity-90 transition-opacity"
      />
      <span class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-surface border border-primary/40 text-[10px] font-mono text-track-screen">
        <span class="w-1.5 h-1.5 rounded-full bg-track-screen animate-pulse"></span>
        v0.1.0 Beta
      </span>
    </a>

    {/* Center Navigation */}
    <nav class="hidden md:flex items-center gap-8 text-xs font-medium text-muted-foreground">
      <a href="#features" class="hover:text-track-screen transition-colors">Features</a>
      <a href="#cursor-engine" class="hover:text-track-screen transition-colors">Cursor Engine</a>
      <a href="#editor" class="hover:text-track-screen transition-colors">Timeline Editor</a>
      <a href="#benchmarks" class="hover:text-track-screen transition-colors">Benchmarks</a>
      <a href="#architecture" class="hover:text-track-screen transition-colors">Architecture</a>
      <a href="#faq" class="hover:text-track-screen transition-colors">FAQ</a>
    </nav>

    {/* Right Action CTAs */}
    <div class="flex items-center gap-3">
      <a
        href="https://github.com/jeandedieuH/recordForge"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-lg bg-surface hover:bg-surface-container-high border border-border text-xs font-medium text-muted-foreground hover:text-foreground transition-all"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
        <span>Star on GitHub</span>
      </a>

      <a
        href="#download"
        class="flex items-center gap-2 px-4 py-2 rounded-xl bg-primary hover:bg-primary-hover text-foreground text-xs font-semibold tracking-wide shadow-lg shadow-primary/30 hover:shadow-primary/50 hover:scale-[1.02] active:scale-[0.98] transition-all"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        <span>Download Free</span>
      </a>
    </div>
  </div>
</header>
