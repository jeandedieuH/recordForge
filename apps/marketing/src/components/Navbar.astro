---
---

<header class="sticky top-0 z-50 w-full border-b border-border bg-background/90 backdrop-blur-xl transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    {/* Brand Logo */}
    <a href="#" class="flex items-center gap-3 group">
      <img
        src="/logo.png"
        alt="RecordForge"
        class="h-12 w-auto object-contain select-none group-hover:opacity-90 transition-opacity"
      />
      <span class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-surface border border-primary/40 text-[10px] font-mono text-track-screen">
        <span class="w-1.5 h-1.5 rounded-full bg-track-screen animate-pulse"></span>
        v1.0 Beta
      </span>
    </a>

    {/* Center Navigation */}
    <nav class="hidden md:flex items-center gap-7 text-xs font-medium text-muted-foreground">
      <a href="#features" class="hover:text-track-screen transition-colors">Features</a>
      <a href="#cursor-engine" class="hover:text-track-screen transition-colors">Cursor Engine</a>
      <a href="#editor" class="hover:text-track-screen transition-colors">Timeline Editor</a>
      <a href="#pricing" class="hover:text-track-screen transition-colors">Pricing &amp; Roadmap</a>
      <a href="#studio" class="hover:text-track-screen transition-colors">About &amp; Studio</a>
      <a href="#faq" class="hover:text-track-screen transition-colors">FAQ</a>
    </nav>

    {/* Right Action CTAs */}
    <div class="flex items-center gap-3">
      <a
        href="https://prestigetech.dev"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:flex items-center gap-2 px-3.5 py-1.5 rounded-lg bg-surface hover:bg-surface-container-high border border-border text-xs font-medium text-muted-foreground hover:text-foreground transition-all group"
      >
        <span class="w-2 h-2 rounded-full bg-primary group-hover:scale-110 transition-transform"></span>
        <span>Prestige Tech</span>
      </a>

      <a
        href="#download"
        class="flex items-center gap-2 px-4 py-2 rounded-xl bg-primary hover:bg-primary-hover text-foreground text-xs font-semibold tracking-wide shadow-lg shadow-primary/30 hover:shadow-primary/50 hover:scale-[1.02] active:scale-[0.98] transition-all"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        <span>Download Free</span>
      </a>
    </div>
  </div>
</header>
