{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "floating-controls",
  "description": "Minimal permissions for recordForge floating transport controls window",
  "windows": ["floating"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "core:window:allow-start-dragging"
  ]
}
