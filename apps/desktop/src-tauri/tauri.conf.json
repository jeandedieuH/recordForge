{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RecordForge",
  "version": "0.1.0",
  "identifier": "com.recordforge.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RecordForge",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPDATA/**/*",
          "$APPLOCALDATA/**",
          "$APPLOCALDATA/**/*",
          "$RESOURCE/**",
          "$RESOURCE/**/*",
          "$TEMP/**",
          "$TEMP/**/*",
          "$DOWNLOAD/**",
          "$DOWNLOAD/**/*",
          "$HOME/**",
          "$HOME/**/*",
          "**"
        ]
      },
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: http://asset.localhost https://asset.localhost asset:",
        "media-src": "'self' data: blob: http://asset.localhost https://asset.localhost asset:",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost http://asset.localhost https://asset.localhost asset:"
      }
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": false
    }
  }
}
