# RecordForge Desktop Environment Example
# Copy this file to .env and fill in your values.

# Google Drive Cloud Storage (OAuth 2.0 Desktop App credentials)
# Google's token endpoint requires the client secret even for Desktop-app
# clients. Release builds embed it via RECORD_FORGE_GOOGLE_DRIVE_CLIENT_SECRET
# at compile time (set as a GitHub Actions secret); in dev it is read from this
# file or the process environment.
RECORD_FORGE_GOOGLE_DRIVE_CLIENT_ID=254207736726-t74i43783vr9gu3vava8uog2n9i9d15k.apps.googleusercontent.com
RECORD_FORGE_GOOGLE_DRIVE_CLIENT_SECRET=
