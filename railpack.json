{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "22",
    "bun": "1.4.2"
  },
  "steps": {
    "install": {
      "deployOutputs": [],
      "commands": ["bun install --frozen-lockfile"]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "deployOutputs": [{ "include": ["apps/web/dist"] }],
      "commands": ["bunx turbo run build --filter=@recordforge/web"]
    },
    "prune": {
      "inputs": [{ "step": "install" }],
      "deployOutputs": [
        {
          "include": [
            "package.json",
            "node_modules",
            "apps/web/package.json",
            "packages"
          ]
        }
      ],
      "commands": [
        "rm -rf node_modules && bun install --production --ignore-scripts"
      ]
    }
  },
  "deploy": {
    "startCommand": "node apps/web/dist/server/server.js"
  }
}
